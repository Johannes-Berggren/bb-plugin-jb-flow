{
  "name": "bb-plugin-jb-flow",
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.54"
  },
  "bb": {
    "name": "JB Flow",
    "description": "Workspaces for your projects, threads and tools, with triage, snooze, PR tracking and live agent activity.",
    "branding": {
      "icon": "TimeSchedule"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "themes": [
      {
        "id": "graphite",
        "name": "Graphite",
        "description": "Quiet charcoal and warm ivory surfaces with a soft violet accent.",
        "css": "./themes/graphite.css"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.54",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test when.test.ts limits.test.ts prs.test.ts awaiting.test.ts decisions.test.ts releases.test.ts unreleased.test.ts lanes.test.ts studio-model.test.ts generic.test.ts && npm run test:ui",
    "test:ui": "vitest run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Johannes-Berggren/bb-plugin-jb-flow"
  }
}

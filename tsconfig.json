{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false
  },
  "include": [
    "decisions.ts",
    "awaiting.ts",
    "leftovers.ts",
    "prs.ts",
    "activity.ts",
    "watchers.ts",
    "limits.ts",
    "focus.ts",
    "repo-commands.ts",
    "repo-panel.tsx",
    "when.ts",
    "server.ts",
    "app.tsx",
    "components",
    "lib",
    "hooks"
  ]
}
